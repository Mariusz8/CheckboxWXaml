<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formularz"
        Height="450" Width="350"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="Wybierz płeć:"
                   FontSize="16"
                   Margin="0,0,0,5"/>


        <RadioButton x:Name="cbMezczyzna"
             Content="Mężczyzna"
             GroupName="Plec"
             Margin="0,5"/>

        <RadioButton x:Name="cbKobieta"
             Content="Kobieta"
             GroupName="Plec"
             Margin="0,5"/>

        <RadioButton x:Name="cbInne"
             Content="Inne"
             GroupName="Plec"
             Margin="0,5"/>


        <TextBlock Text="Wiek:"
                   FontSize="16"
                   Margin="0,15,0,5"/>

        <TextBox x:Name="txtWiek"
                 Height="28"
                 Padding="5"/>

        <TextBlock Text="Wybierz kolor:"
                   FontSize="16"
                   Margin="0,15,0,5"/>

        <ComboBox x:Name="cmbKolor"
                  Height="28"
                  SelectedIndex="0">
            <ComboBoxItem Content="Czerwony"/>
            <ComboBoxItem Content="Zielony"/>
            <ComboBoxItem Content="Niebieski"/>
            <ComboBoxItem Content="Żółty"/>
        </ComboBox>

        <CheckBox x:Name="cbZgoda"
                  Content="Wyrażam zgodę"
                  Margin="0,20,0,10"/>

        <Button Content="Zapisz"
                Height="35"
                Click="Zapisz_Click"/>

    </StackPanel>
</Window>
